SERVICENOW_INSTANCE_URL=https://dev285539.service-now.com/
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password
SERVICENOW_KNOWLEDGE_BASE_SYS_ID=your_knowledge_base_sys_id

# Shared secret the ServiceNow Business Rule sends in the
# "X-ServiceNow-Secret" header on every webhook call.
# Must match on both sides.
SERVICENOW_WEBHOOK_SECRET=your_webhook_secret


# --- Embedding settings (S2.2/S2.3) ---
# Option A: Direct Gemini API (used by embedding.py create_embedding fallback)
GEMINI_API_KEY=your_gemini_api_key

# Option B: LiteLLM proxy (used by embeddings.py for production)
# Required when using embeddings.py gemini_embedding_fn via LiteLLM
LITELLM_BASE_URL=https://management.sprints.ai/litellm
LITELLM_API_KEY=your_litellm_api_key


# --- Qdrant / vector storage settings (S2.2) ---
QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=kb_chunks
RETRIEVAL_SCORE_THRESHOLD=0.65
RETRIEVAL_TOP_K=5


# --- LLM / Agent settings (S2.4 - S2.5) ---
LLM_MODEL=gemini/gemini-3.6-flash
LLM_TEMPERATURE=0.0