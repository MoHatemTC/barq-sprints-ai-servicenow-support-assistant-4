SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com/
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_servicenow_password_here
SERVICENOW_KNOWLEDGE_BASE_SYS_ID=your_kb_sys_id_here

# --- ServiceNow incident webhook signing ---
# Must match the HMAC secret configured in the ServiceNow Business Rule.
# The receiver expects the signature in the X-Signature header.
INCIDENT_SIGNING_SECRET=your_incident_signing_secret
KB_SIGNING_SECRET=your_kb_signing_secret

# --- Gemini / Embedding settings (S2.2) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- LiteLLM proxy ---
LITELLM_BASE_URL=https://management.sprints.ai/litellm
LITELLM_API_KEY=your_litellm_api_key_here

# --- Qdrant / vector storage settings (S2.2) ---
QDRANT_URL=your_qdrant_cluster_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=barq_kb_chunks

# --- Retrieval settings (S2.3) ---
RETRIEVAL_SCORE_THRESHOLD=0.75
RETRIEVAL_TOP_K=5

# --- Celery / Redis settings (S3.3 / S3.6) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Redis event deduplication ---
DEDUP_KEY_PREFIX=evt:
DEDUP_TTL_SECONDS=86400

# --- SQL state store for KB sync ---
KB_STATE_DB_URL=sqlite:///./kb_state.db

# --- Tracing settings (S3.6) ---
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Agent LLM settings (S3.4) ---
# The agent's ChatOpenAI client reads OPENAI_API_KEY.
# Set it to the same LiteLLM proxy key as LITELLM_API_KEY.
OPENAI_API_KEY=your_litellm_api_key_here
LLM_MODEL=gemini/gemini-3.5-flash
LLM_TEMPERATURE=0.0

# --- S3.4 worker settings ---
# Must match the actual scoped AI field prefix on your ServiceNow instance.
AI_FIELD_PREFIX=x_your_pdi_scope_number_
AGENT_MAX_STEPS=6

# --- PDF ingestion via LiteLLM proxy (S3.5) ---
# EMBEDDING_MODEL=gemini/gemini-embedding-001
# EMBEDDING_DIM=768
# VISION_MODEL=gemini/gemini-3.6-flash