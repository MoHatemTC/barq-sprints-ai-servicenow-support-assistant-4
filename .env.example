SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password
SERVICENOW_KNOWLEDGE_BASE_SYS_ID=your_knowledge_base_sys_id

# Shared secret the ServiceNow Business Rule sends in the
# "X-ServiceNow-Secret" header on every webhook call (see
# businessRule/business_rule.js). Must match on both sides.
SERVICENOW_WEBHOOK_SECRET=barq-g4-secure-token


# --- Gemini / Embedding settings (S2.2) ---
GEMINI_API_KEY=your_gemini_api_key


# --- Qdrant / vector storage settings (S2.2) ---
QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=barq_kb_chunks


# --- Retrieval settings (S2.3) ---
RETRIEVAL_SCORE_THRESHOLD=0.75
RETRIEVAL_TOP_K=5


# --- Agent LLM settings (S3.4) ---
# The Sprints-provided LiteLLM proxy gives access to a Gemini model
# through an OpenAI-compatible endpoint.
LITELLM_BASE_URL=https://management.sprints.ai/litellm
# The proxy's own bearer token - ask your mentor/Sprints admins for this.
# NOT the same thing as GEMINI_API_KEY above (that's only used for embedding).
OPENAI_API_KEY=your_litellm_proxy_key
LLM_MODEL=gemini-3.5-flash


# --- S3.4 worker settings ---
# Application scope prefix for the AI incident fields (ai_status,
# ai_confidence, ai_suggested_response, human_review_required,
# ai_processed). This scope is owned by S3.1 - update this value once the
# real scope name is confirmed, no code changes needed.
AI_FIELD_PREFIX=x_2066139_ai_triag_
# Max ReAct loop iterations before the fail-safe escalation fires.
AGENT_MAX_STEPS=6