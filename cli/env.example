# ---- OpenAI-compatible endpoint (LiteLLM proxy). Never commit the real .env ----
LITELLM_BASE_URL=https://<your-litellm-host>/v1
LITELLM_API_KEY=sk-...
EMBEDDING_MODEL=<same embedding model the KB indexer uses>
# EMBEDDING_DIM=            # only if the model supports the `dimensions` parameter
VISION_MODEL=<vision-capable model alias on the proxy>   # leave empty to run Tesseract-only

# ---- Qdrant (shared collection with the ServiceNow KB articles) ----
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=<shared collection name>
# QDRANT_VECTOR_NAME=       # only if the collection uses named vectors
